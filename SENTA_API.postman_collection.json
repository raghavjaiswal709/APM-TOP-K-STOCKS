    {
      "name": "Reference",
      "item": [
        {
          "name": "Holidays — NSE Calendar",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/senta/holidays",
              "host": ["{{base_url}}"],
              "path": ["api", "senta", "holidays"]
            },
            "description": "NSE trading holiday list. Fetched from nseindia.com and cached 12 hours."
          }
        }
      ]
    },
    {
      "name": "Debug / Diagnostics",
      "item": [
        {
          "name": "Debug Live — Nifty 50",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/senta/debug-live?symbol=IDX_NIFTY50",
              "host": ["{{base_url}}"],
              "path": ["api", "senta", "debug-live"],
              "query": [
                { "key": "symbol", "value": "IDX_NIFTY50", "description": "Live API symbol: IDX_NIFTY50 | IDX_NIFTYBANK | IDX_INDIAVIX | IDX_SENSEX | IDX_NIFTY500 | IDX_NIFTYFMCG | IDX_NIFTYIT | IDX_NIFTYMETAL | IDX_FINNIFTY | IDX_NIFTYAUTO | IDX_NIFTYPHARMA | IDX_NIFTYPVTBANK | IDX_NIFTYPSUBANK | IDX_NIFTYREALTY | IDX_NIFTYHEALTHCARE | IDX_NIFTYINFRA | IDX_NIFTYCOMMODITIES | IDX_NIFTYENERGY | IDX_NIFTYMEDIA" }
              ]
            },
            "description": "Probes LIVE_DATA_URL:5110/market_data directly. Returns bar count and sample timestamps. Useful to verify live data pipeline is flowing."
          }
        },
        {
          "name": "Debug Live — India VIX",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/senta/debug-live?symbol=IDX_INDIAVIX",
              "host": ["{{base_url}}"],
              "path": ["api", "senta", "debug-live"],
              "query": [
                { "key": "symbol", "value": "IDX_INDIAVIX" }
              ]
            }
          }
        },
        {
          "name": "Debug Live — Custom stock symbol",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/senta/debug-live?symbol={{symbol}}",
              "host": ["{{base_url}}"],
              "path": ["api", "senta", "debug-live"],
              "query": [
                { "key": "symbol", "value": "{{symbol}}", "description": "Use the Fyers-style symbol e.g. BHEL, RELIANCE (for stocks the live API maps NSE:BHEL-EQ style)" }
              ]
            }
          }
        }
