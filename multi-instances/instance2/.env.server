# ═══════════════════════════════════════════════════════════════════════════
# DAKS TOP-K STOCKS - Instance 2 Configuration
# Server: 100.93.172.21
# Frontend: 3002 | Backend: 5102 | Fyers: 8101/8110
# ═══════════════════════════════════════════════════════════════════════════

# Instance Identification
INSTANCE_ID=instance2
INSTANCE_NAME="DAKS Instance 2"
INSTANCE_REGION=local

# ═══════════════════════════════════════════════════════════════════════════
# PORT CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════

FRONTEND_PORT=3002
BACKEND_PORT=5102
FYERS_5001_PORT=8101
FYERS_5010_PORT=8110
REDIS_PORT=6382

# ═══════════════════════════════════════════════════════════════════════════
# DATABASE CONFIGURATION - EXTERNAL PostgreSQL
# Connects to the same database as main app at 100.93.172.21:5432
# ═══════════════════════════════════════════════════════════════════════════

DB_HOST=100.93.172.21
DB_PORT=5432
DB_USERNAME=readonly_user
DB_PASSWORD=db_read_5432
DB_DATABASE=nse_hist_db

# ═══════════════════════════════════════════════════════════════════════════
# REDIS CONFIGURATION - Internal Docker
# ═══════════════════════════════════════════════════════════════════════════

REDIS_HOST=redis
REDIS_PORT_INTERNAL=6379
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=

# ═══════════════════════════════════════════════════════════════════════════
# FYERS API CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════

FYERS_CLIENT_ID=150HUKJSWG-100
FYERS_SECRET_ID=18YYNXCAS7
FYERS_REDIRECT_URI=https://raghavjaiswal709.github.io/DAKSphere_redirect
FYERS_ACCESS_TOKEN=your_access_token

# ═══════════════════════════════════════════════════════════════════════════
# ENVIRONMENT CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════

NODE_ENV=development
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
TZ=Asia/Kolkata

# ═══════════════════════════════════════════════════════════════════════════
# SERVICE URLS - BROWSER ACCESSIBLE (NEXT_PUBLIC_*)
# These are used by the browser to connect to APIs
# ═══════════════════════════════════════════════════════════════════════════

NEXT_PUBLIC_API_URL=http://100.93.172.21:5102
NEXT_PUBLIC_WS_URL=ws://100.93.172.21:5102
NEXT_PUBLIC_BACKEND_URL=http://100.93.172.21:5102
NEXT_PUBLIC_FYERS_SERVICE_5001_URL=http://100.93.172.21:8101
NEXT_PUBLIC_FYERS_SERVICE_5010_URL=http://100.93.172.21:8110
NEXT_PUBLIC_FYERS_SOCKET_URL=http://100.93.172.21:8101
NEXT_PUBLIC_LIVE_MARKET_SOCKET_URL=http://100.93.172.21:8110

# ═══════════════════════════════════════════════════════════════════════════
# INTERNAL DOCKER NETWORK URLS
# These are used by containers to communicate with each other
# ═══════════════════════════════════════════════════════════════════════════

BACKEND_URL=http://backend:5002
FYERS_SERVICE_5001_URL=http://fyers-5001:5001
FYERS_SERVICE_5010_URL=http://fyers-5010:5010

# ═══════════════════════════════════════════════════════════════════════════
# EXTERNAL API URLS (Running on main server)
# ═══════════════════════════════════════════════════════════════════════════

SIPR_API_URL=http://100.93.172.21:8510
PREDICTION_API_URL=http://100.93.172.21:5112
PREMARKET_API_URL=http://100.93.172.21:5717

# ═══════════════════════════════════════════════════════════════════════════
# LOGGING CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════

LOG_LEVEL=debug
LOG_DIR=/app/logs

# ═══════════════════════════════════════════════════════════════════════════
# PERFORMANCE CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════

MAX_CONNECTIONS=100
REDIS_MAX_MEMORY=512mb
WORKER_THREADS=4

# ═══════════════════════════════════════════════════════════════════════════
# USER INFORMATION
# ═══════════════════════════════════════════════════════════════════════════

NEXT_PUBLIC_INSTANCE_USER_NAME="Instance 2 User"
NEXT_PUBLIC_INSTANCE_USER_EMAIL="user2@daks.com"
