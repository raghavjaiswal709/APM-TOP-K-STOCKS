# ═══════════════════════════════════════════════════════════════════════════
# DAKS TOP-K STOCKS - Instance Configuration Template
# Copy this and customize for each instance
# ═══════════════════════════════════════════════════════════════════════════

# Instance Identification
INSTANCE_ID=instance1
INSTANCE_NAME="DAKS Instance 1"
INSTANCE_REGION=local

# ═══════════════════════════════════════════════════════════════════════════
# PORT CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════

FRONTEND_PORT=3001
BACKEND_PORT=5502
FYERS_5001_PORT=8001
FYERS_5010_PORT=8010
POSTGRES_PORT=5432
REDIS_PORT=6379

# ═══════════════════════════════════════════════════════════════════════════
# DATABASE CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════

POSTGRES_USER=readonly_user
POSTGRES_PASSWORD=db_read_5432
POSTGRES_DB=nse_hist_db
#DATABASE_URL=postgresql://readonly_user:db_read_5432@100.93.172.21:5432/nse_hist_db

# ═══════════════════════════════════════════════════════════════════════════
# REDIS CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════

REDIS_URL=redis://redis:6379
REDIS_PASSWORD=

# ═══════════════════════════════════════════════════════════════════════════
# FYERS API CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════

FYERS_CLIENT_ID=150HUKJSWG-100
FYERS_SECRET_ID=18YYNXCAS7
FYERS_REDIRECT_URI=https://raghavjaiswal709.github.io/DAKSphere_redirect
FYERS_ACCESS_TOKEN=your_access_token

# ═══════════════════════════════════════════════════════════════════════════
# ENVIRONMENT CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════

NODE_ENV=development
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
TZ=Asia/Kolkata

# ═══════════════════════════════════════════════════════════════════════════
# SERVICE URLS (FOR INTERNAL COMMUNICATION)
# ═══════════════════════════════════════════════════════════════════════════

NEXT_PUBLIC_API_URL=http://localhost:5502
NEXT_PUBLIC_BACKEND_URL=http://localhost:5502
BACKEND_URL=http://backend:5002
FYERS_SERVICE_5001_URL=http://localhost:8001
FYERS_SERVICE_5010_URL=http://localhost:8010
NEXT_PUBLIC_LIVE_MARKET_SOCKET_URL=http://localhost:8010
NEXT_PUBLIC_FYERS_SERVICE_5010_URL=http://localhost:8010
NEXT_PUBLIC_FYERS_SOCKET_URL=http://localhost:8001
NEXT_PUBLIC_FYERS_SERVICE_5001_URL=http://localhost:8001

# ═══════════════════════════════════════════════════════════════════════════
# LOGGING CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════

LOG_LEVEL=debug
LOG_DIR=/app/logs

# ═══════════════════════════════════════════════════════════════════════════
# PERFORMANCE CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════

MAX_CONNECTIONS=100
REDIS_MAX_MEMORY=512mb
WORKER_THREADS=4


# User Information
NEXT_PUBLIC_INSTANCE_USER_NAME="Instance 1 User"
NEXT_PUBLIC_INSTANCE_USER_EMAIL="user1@daks.com"
